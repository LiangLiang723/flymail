{
  "name": "flymail-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v2": "vite --open /",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "test:v2": "node --test tests/v2/*.test.ts",
    "generate:v2-api": "node scripts/sync-v2-api-types.mjs",
    "check:v2-api-types": "node scripts/sync-v2-api-types.mjs --check",
    "build": "vue-tsc && vite build && node scripts/check-v2-bundle-budget.mjs ../dist/ui",
    "build:v2": "vue-tsc && vite build && node scripts/check-v2-bundle-budget.mjs ../dist/ui",
    "check:v2-bundle": "node scripts/check-v2-bundle-budget.mjs ../dist/ui",
    "preview": "vite preview"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  },
  "dependencies": {
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-font-family": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-list-item": "^3.26.0",
    "@tiptap/extension-paragraph": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/vue-3": "^3.26.0",
    "axios": "^1.6.0",
    "dompurify": "^3.4.8",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.0"
  }
}
